# Copy to .env and fill in. .env is gitignored; never commit real values.
# Names only in this file. These are read by the runtime (src/runtime), never by the renderer.

# Model providers (PLAN.md step 1.3). v1 uses Groq, with local Ollama as the fallback.
GROQ_API_KEY=
# Optional. Leave empty to use the default, http://localhost:11434.
OLLAMA_BASE_URL=
# Optional model names. Leave empty to use the placeholder defaults in src/runtime/router.js.
# Groq is skipped until GROQ_API_KEY is set; Ollama needs no key, only the model pulled locally.
GROQ_MODEL=
OLLAMA_MODEL=
# The Claude Code fallback has no key here on purpose: it uses the `claude` login already on this
# machine. Do not set ANTHROPIC_API_KEY for it. That would switch it to per-token billing, and the
# runtime removes the variable from the child process anyway.

# Deferred, not used in v1. Uncomment when these providers are added.
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Telegram bot (step 1.8). The bot only answers the founder's chat.
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=

# Supabase (step 1.1). The service role key bypasses row-level security: runtime only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only for `npm run db:migrate` (applies supabase/migrations to your project). Create it at
# https://supabase.com/dashboard/account/tokens. It can manage every project on your account:
# the app never reads it, and you can delete it in the dashboard once the migrations are applied.
SUPABASE_ACCESS_TOKEN=

# Filesystem tools (step 1.10): the ONE folder agents may read. Leave empty to use the app's own folder.
# Secrets (.env files, keys, .git, node_modules) are never readable, and nothing outside this folder is.
FILESYSTEM_ROOT=

# Library documentation for the Engineering team (step 3.3), through Context7. Optional: it works without a key, with lower limits.
CONTEXT7_API_KEY=

# Projects (step 3.1): the ONE folder where each project gets its own space (files and git history), one subfolder per project.
# Leave empty to use a "pods" folder in the app's own data folder. Must be an absolute path if set.
# What it looks like (a sample, not a real value):  PODS_ROOT=/Users/yourname/sfactory-projects
PODS_ROOT=

# GitHub tools (step 1.10). Both must be set, or there are no GitHub tools. GITHUB_REPOS is the ONLY list of
# repositories agents can touch: comma-separated owner/name, for example acme/site,acme/app.
# Use a fine-grained token limited to those repositories: Contents (read and write, so a branch can be pushed) and Pull requests (read and write),
# and nothing else. The Engineering team pushes branches and opens pull requests only: it can never merge, and never touches the main line.
# What they look like (samples, not real values):
#   GITHUB_TOKEN=github_pat_11ABCDEFG0xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   GITHUB_REPOS=yourname/pipeline-test            (one repository)
#   GITHUB_REPOS=yourname/site,yourname/app        (several, separated by commas, no spaces)
GITHUB_TOKEN=
GITHUB_REPOS=

# Outbound client messages (step 2.2). Every message to a client is reviewed first. While the founder's approval is required
# each one also waits for your Yes on a card. This is the LAST day of that period, for example 2026-12-09 (about two weeks after
# you go live). Leave it empty and you approve every message, always. A date that is not a date also means always.
OUTBOUND_FOUNDER_APPROVAL_UNTIL=

# Marketing and Sales team (step 2.3).
# Web search (Tavily). Get a key at https://app.tavily.com/ (it starts with tvly-; the free plan is enough to start). Without it the team has no search tool.
TAVILY_API_KEY=
# Gmail and Drive. All three must be set, or there are no Gmail or Drive tools. Make an OAuth client in Google Cloud Console and sign in once to
# get the refresh token. Ask for only these scopes: gmail.readonly, gmail.compose and drive.file. The tools read mail, make DRAFTS and save files;
# nothing in the code sends mail, so a draft stays in your Drafts folder until you send it yourself.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Morning digest (step 2.6). The time of day, in Indian time (IST) and written as 24-hour HH:MM, when the Telegram bot sends your daily brief.
# Leave it empty for 09:00. Write off to turn the digest off. The /brief command always works. A time that is not a time turns the digest off
# and the app says so. If the app was closed at that time, the digest goes out when it starts, up to six hours later, and never twice in a day.
DIGEST_TIME_IST=

# Autoscaling (step 4.1): how often, in seconds, the app looks at each team's waiting work, adds or removes agents and closes finished projects.
# Default 60. The smallest is 10. Write off to turn it off. What it looks like (a sample, not a real value):  AUTOSCALE_EVERY_SECONDS=60
AUTOSCALE_EVERY_SECONDS=
